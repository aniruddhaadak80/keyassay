# Keyassay environment.
#
# NONE of these are required for local development. With no .env.local at all the
# repository adapter falls back to an embedded PGlite instance and the app runs
# with zero configuration.
#
# Copy to .env.local (gitignored) only if you want to exercise a particular path.
# Never commit real values.

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------

# Hosted Postgres. Required in production: the app refuses to start a
# production build without it rather than silently writing to volatile storage.
# Neon through the Vercel Marketplace integration works; any Postgres provider
# works. Production verification reports which adapter is live at /api/health.
# DATABASE_URL=

# Optional schema namespacing, so a shared instance can host several projects.
# Must be a plain SQL identifier.
# DATABASE_SCHEMA=public

# The canonical public origin, used for canonical URLs, OpenGraph metadata, the
# sitemap and the agent manifest. Vercel injects this automatically.
# NEXT_PUBLIC_SITE_URL=https://keyassay.vercel.app

# ---------------------------------------------------------------------------
# Local escape hatches — never set these in a real deployment
# ---------------------------------------------------------------------------

# Permits the embedded PGlite adapter to run in a production-mode build. The
# local browser smoke test needs this because `next start` sets NODE_ENV=production;
# data written this way is NOT durable. The app logs a warning when it is set.
# KEYASSAY_ALLOW_EMBEDDED=1

# Where the embedded adapter stores its data directory. Use :memory: for a
# throwaway instance.
# PGLITE_DIR=.pglite